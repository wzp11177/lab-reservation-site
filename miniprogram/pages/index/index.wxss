.page {
  min-height: 100vh;
  padding: 28rpx;
  box-sizing: border-box;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.title {
  display: block;
  color: #16202a;
  font-size: 44rpx;
  font-weight: 700;
}

.subTitle {
  display: block;
  margin-top: 6rpx;
  color: #697789;
  font-size: 26rpx;
}

.refreshButton {
  min-width: 132rpx;
  height: 68rpx;
  color: #16202a;
  background: #ffffff;
  border: 1rpx solid #d9e1dc;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 650;
}

.panel {
  margin-bottom: 18rpx;
}

.label {
  display: block;
  margin-bottom: 10rpx;
  color: #697789;
  font-size: 26rpx;
  font-weight: 650;
}

.segment {
  display: grid;
  gap: 8rpx;
  padding: 8rpx;
  background: #ffffff;
  border: 1rpx solid #d9e1dc;
  border-radius: 14rpx;
}

.three {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.two {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.segmentButton {
  height: 70rpx;
  color: #314052;
  background: transparent;
  border-radius: 10rpx;
  font-size: 28rpx;
  font-weight: 650;
}

.active {
  color: #ffffff;
  background: #0f766e;
}

.dayTabs {
  width: 100%;
  margin: 24rpx 0 18rpx;
  white-space: nowrap;
}

.dayTab {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 98rpx;
  margin-right: 10rpx;
  color: #314052;
  background: #ffffff;
  border: 1rpx solid #d9e1dc;
  border-radius: 14rpx;
  font-size: 24rpx;
}

.dayNumber {
  margin-top: 4rpx;
  color: #16202a;
  font-size: 34rpx;
  font-weight: 750;
}

.dayActive {
  color: #ffffff;
  background: #0f766e;
  border-color: #0f766e;
}

.dayActive .dayNumber {
  color: #ffffff;
}

.statusRow {
  min-height: 44rpx;
  margin-bottom: 12rpx;
}

.status {
  display: block;
  color: #697789;
  font-size: 24rpx;
}

.error {
  display: block;
  margin-top: 6rpx;
  color: #b42318;
  font-size: 24rpx;
}

.slotList {
  display: grid;
  gap: 10rpx;
}

.slotRow {
  display: grid;
  grid-template-columns: 104rpx 1fr;
  gap: 12rpx;
  align-items: center;
}

.time {
  color: #697789;
  font-size: 28rpx;
  font-weight: 650;
}

.slotButton {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 82rpx;
  padding: 0 24rpx;
  color: #697789;
  background: #ffffff;
  border: 1rpx solid #d9e1dc;
  border-radius: 12rpx;
  box-sizing: border-box;
}

.slotMain {
  font-size: 30rpx;
  font-weight: 700;
}

.slotSub {
  color: #697789;
  font-size: 24rpx;
  font-weight: 650;
}

.booked {
  background: #fffaf3;
  border-color: #e9c891;
}

.booked .slotMain {
  color: #8a4b08;
}

.own {
  background: #eefaf6;
  border-color: #9bd8ca;
}

.own .slotMain {
  color: #0f766e;
}
